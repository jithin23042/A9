
classDiagram
    class OrderStatusService {
        -OrderRepository repository
        -EventPublisher publisher
        +update_status(order_id, new_status) bool
    }

    class OrderRepository {
        -dict orders
        +add(order) None
        +get(order_id) Order
        +update_status(order_id, new_status) None
    }

    class Order {
        +str order_id
        +str customer_phone
        +OrderStatus status
    }

    class OrderStatusChangedEvent {
        +str order_id
        +OrderStatus previous_status
        +OrderStatus new_status
        +str customer_phone
    }

    class EventPublisher {
        -list observers
        +subscribe(observer) None
        +publish(event) None
    }

    class OrderStatusObserver {
        <<abstract>>
        +update(event) None
    }

    class OrderStatusSmsListener {
        -SmsProvider provider
        +update(event) None
    }

    class AuditObserver {
        +list events
        +update(event) None
    }

    class SmsProvider {
        <<abstract>>
        +send_sms(phone, message) bool
    }

    class UnconfiguredSmsProvider {
        +send_sms(phone, message) bool
    }

    OrderStatusService --> OrderRepository : persists status
    OrderStatusService --> EventPublisher : publishes events
    OrderRepository o-- Order : stores
    EventPublisher --> OrderStatusObserver : notifies
    OrderStatusService ..> OrderStatusChangedEvent : creates
    OrderStatusObserver <|.. OrderStatusSmsListener : implements
    OrderStatusObserver <|.. AuditObserver : implements
    OrderStatusSmsListener --> SmsProvider : delegates delivery
    SmsProvider <|.. UnconfiguredSmsProvider : implements
