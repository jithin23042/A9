classDiagram
    class PaymentProcessor {
        -dict~str, PaymentStrategy~ _strategies
        +__init__(strategies: Iterable~PaymentStrategy~)
        +register_strategy(strategy: PaymentStrategy) None
        +process_payment(provider: str, amount: Decimal|int|float|str) PaymentResult
    }

    class PaymentStrategy {
        <<abstract>>
        +provider_key str
        +pay(amount: Decimal) PaymentResult
    }

    class CardPayment {
        +provider_key str
        +pay(amount: Decimal) PaymentResult
    }

    class UPIPayment {
        +provider_key str
        +pay(amount: Decimal) PaymentResult
    }

    class PaymentResult {
        <<dataclass, frozen>>
        +provider: str
        +amount: Decimal
        +status: str
        +message: str
    }

    PaymentProcessor "1" o--> "0..*" PaymentStrategy : registers and selects
    PaymentStrategy <|-- CardPayment : implements
    PaymentStrategy <|-- UPIPayment : implements
    CardPayment ..> PaymentResult : creates
    UPIPayment ..> PaymentResult : creates
