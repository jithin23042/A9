%% Verified against the Part 2 Shopizer source:
%% sm-shop/.../OrderFacadeImpl.java
%% sm-shop/.../OrderStatusChangedEvent.java
%% sm-shop/.../OrderStatusSmsListener.java
%% sm-shop/.../SmsProvider.java
%% sm-shop/.../UnconfiguredSmsProvider.java
classDiagram
    direction LR

    class OrderFacadeImpl {
        -ApplicationEventPublisher eventPublisher
        +updateOrderStatus(Order order, OrderStatus newStatus, MerchantStore store) void
    }

    class OrderService {
        +addOrderStatusHistory(Order order, OrderStatusHistory history) void
    }

    class ApplicationEventPublisher {
        <<Spring interface>>
        +publishEvent(Object event) void
    }

    class OrderStatusChangedEvent {
        -Order order
        -OrderStatus oldStatus
        -OrderStatus newStatus
        -String transitionId
        +getOrder() Order
        +getOldStatus() OrderStatus
        +getNewStatus() OrderStatus
        +getTransitionId() String
    }

    class ApplicationListener {
        <<Spring interface>>
        +onApplicationEvent(OrderStatusChangedEvent event) void
    }

    class OrderStatusSmsListener {
        -SmsProvider smsProvider
        -Map~String, Boolean~ notifiedTransitions
        -Map~String, Boolean~ transitionsInProgress
        +onApplicationEvent(OrderStatusChangedEvent event) void
        -isSmsStatus(OrderStatus status) boolean
        -phoneNumber(Order order) String
    }

    class SmsProvider {
        <<interface>>
        +sendSms(String phoneNumber, String message) void
    }

    class UnconfiguredSmsProvider {
        +sendSms(String phoneNumber, String message) void
    }

    class OrderStatus {
        <<enum>>
        SHIPPED
        DELIVERED
    }

    OrderFacadeImpl --> OrderService : writes status history
    OrderFacadeImpl --> ApplicationEventPublisher : publishes event
    OrderFacadeImpl ..> OrderStatusChangedEvent : creates when status changes
    ApplicationEventPublisher ..> ApplicationListener : Spring event dispatch
    ApplicationListener <|.. OrderStatusSmsListener : implements
    OrderStatusChangedEvent --> OrderStatus : old and new status
    OrderStatusChangedEvent --> Order : carries order
    OrderStatusSmsListener --> SmsProvider : sendSms(...)
    SmsProvider <|.. UnconfiguredSmsProvider : default component

    note for OrderFacadeImpl "Same-status updates return immediately. Event publication follows the status-history write in the method body for SHIPPED or DELIVERED."
    note for OrderStatusSmsListener "Runs asynchronously; uses delivery telephone first and billing telephone as fallback. Transition deduplication is bounded and process-local."
    note for UnconfiguredSmsProvider "Default implementation throws IllegalStateException until a deployment supplies an SMS provider."
