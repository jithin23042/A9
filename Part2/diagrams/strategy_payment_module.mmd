classDiagram
    class PaymentModule {
      <<interface>>
      +initTransaction(...)
      +authorize(...)
      +authorizeAndCapture(...)
      +capture(...)
      +refund(...)
    }
    class PaymentServiceImpl {
      -paymentModules
      +select payment module by code
    }
    class RazorpayPayment {
      +initTransaction(...)
      +authorize(...)
      +authorizeAndCapture(...)
      +capture(...)
      +refund(...)
    }
    class ExistingPaymentProviders {
      BeanStreamPayment
      BraintreePayment
      MoneyOrderPayment
      PayPalExpressCheckoutPayment
      PayPalRestPayment
      Stripe3Payment
      StripePayment
    }
    PaymentModule <|.. RazorpayPayment
    PaymentModule <|.. ExistingPaymentProviders
    PaymentServiceImpl --> PaymentModule : selects by module code
